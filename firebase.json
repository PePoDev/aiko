{
  "firestore": { "rules": "firebase/firestore.rules", "indexes": "firebase/firestore.indexes.json" },
  "storage": { "rules": "firebase/storage.rules" },
  "functions": [{ "source": "firebase/functions", "codebase": "aiko", "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"] }],
  "hosting": { "public": "build/web", "ignore": ["firebase.json", "**/.*", "**/node_modules/**"], "rewrites": [{ "source": "**", "destination": "/index.html" }] },
  "emulators": {
    "auth": { "host": "127.0.0.1", "port": 9099 },
    "firestore": { "host": "127.0.0.1", "port": 8081 },
    "storage": { "host": "127.0.0.1", "port": 9199 },
    "functions": { "host": "127.0.0.1", "port": 5001 },
    "hosting": { "host": "0.0.0.0", "port": 8080 },
    "ui": { "enabled": true, "host": "127.0.0.1", "port": 4000 },
    "singleProjectMode": true
  }
}
