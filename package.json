{
  "name": "aiko-development",
  "private": true,
  "scripts": {
    "functions:build": "npm --prefix firebase/functions run build",
    "firebase:start": "sh tool/run_emulators.sh",
    "test:rules": "node --test firebase/test/*.test.cjs",
    "test:web": "node --test tool/test/*.test.mjs",
    "web:precache": "node tool/web_precache.mjs build/web",
    "docs:check": "node tool/check_docs.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.0.0",
    "firebase-tools": "^15.0.0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.5"
    },
    "@google-cloud/pubsub": {
      "@opentelemetry/core": "^2.8.0"
    },
    "firebase-tools": {
      "chokidar": "^4.0.3"
    },
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "get-uri": {
      "basic-ftp": "^6.2.3"
    }
  }
}
