# Local Firebase emulators (no Firebase account or cloud project required).
FIREBASE_PROJECT_ID=demo-aiko
FIREBASE_EMULATOR_HOST=127.0.0.1
# For production, remove FIREBASE_EMULATOR_HOST and set the per-platform values
# from your Firebase project settings (or generate them with FlutterFire CLI).
# FIREBASE_API_KEY=
# FIREBASE_APP_ID=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_REGION=us-central1
